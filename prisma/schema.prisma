generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model ParentProfile {
  id                  String              @id @default(uuid())
  cognitoSub          String              @unique
  firstName           String
  lastName            String
  visibleName         String?
  tuitionType         String?
  nationality         String?
  nriOrIndian         String?
  address             String?
  city                String?
  country             String?
  pincode             String?
  currency            String?
  timezone            String?
  phone               String
  whatsappNumber      String?
  email               String              @unique
  relationToStudent   String?
  childStatus         String?
  onlineTuition       String?
  modeOfCommunication String?
  childInterest       String?
  favoriteSubject     String?
  weakSubject         String?
  preferredLanguage   String?
  howDidYouHear       String?
  suggestions         String?
  onboardingComplete  Boolean             @default(false)
  /// Account Settings (Sep 10, 2026) — master in-app notification
  /// toggle backing `/parent/settings`. Checked in
  /// notification.service.ts before any Notification row is written
  /// for this recipient; turning it off never deletes existing
  /// notifications, only stops new ones. MVP-minimal, same spirit as
  /// the Notification model itself — see 06-OPEN-DECISIONS.md #32 for
  /// the fuller per-category version still deferred to Phase 2.
  notificationsEnabled Boolean            @default(true)
  createdAt           DateTime            @default(now())
  chatRooms           ChatRoom[]
  classSessions       ClassSession[]
  demoCoupon          DemoCoupon?
  demoCouponPurchases DemoCouponPurchase[]
  enrollments         Enrollment[]
  homeworks           Homework[]
  students            Student[]
  wallet              Wallet?
  rescheduleRequests  RescheduleRequest[]
  referralCode        String?              @unique
  referralsMade       Referral[]           @relation("ReferralsMade")
  referralReceived    Referral?            @relation("ReferralReceived")
  reviews             Review[]
  certificates        Certificate[]
}

model Admin {
  id        String   @id @default(uuid())
  cognitoId String   @unique
  email     String   @unique
  firstName String
  lastName  String
  createdAt DateTime @default(now())
}

model Student {
  id                   String         @id @default(uuid())
  parentId             String
  firstName            String
  lastName             String
  visibleName          String?
  gender               String?
  age                  Int?
  dateOfBirth          DateTime?
  standard             String?
  board                String?
  currentSchoolName    String?
  learningDifficulties String?
  photoUrl             String?
  createdAt            DateTime       @default(now())
  chatRooms            ChatRoom[]
  classSessions        ClassSession[]
  demoBookings         DemoBooking[]
  enrollments          Enrollment[]
  homeworks            Homework[]
  parent               ParentProfile  @relation(fields: [parentId], references: [id], onDelete: Cascade)
  certificates         Certificate[]

  @@index([parentId])
}

model Teacher {
  id                 String                @id @default(uuid())
  cognitoId          String                @unique
  email              String                @unique
  firstName          String
  lastName           String
  visibleName        String?
  dobDay             Int?
  dobMonth           String?
  dobYear            Int?
  gender             String?
  nationality        String?
  address            String?
  city               String?
  country            String?
  pincode            String?
  phone              String?
  whatsapp           String?
  aboutMe            String?
  criminalCase       String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  approvalStatus     TeacherApprovalStatus @default(PENDING)
  currentStep        Int                   @default(1)
  onboardingStatus   String                @default("IN_PROGRESS")
  panCardNumber      String?
  /// Account Settings (Sep 10, 2026) — same toggle as
  /// `ParentProfile.notificationsEnabled`, backing `/teacher/settings`.
  notificationsEnabled Boolean             @default(true)
  /// Self-declared at onboarding Step 1 (Sep 2026) — no Admin approval
  /// gate, unlike `approvalStatus`. When true, every course this
  /// Teacher creates is forced to `Course.isIITian = true` / the fixed
  /// ₹700 rate server-side (see createCourse in course.service.ts),
  /// regardless of what the create-course form submits.
  isIITian           Boolean               @default(false)
  chatRooms          ChatRoom[]
  classSessions      ClassSession[]
  courses            Course[]
  demoBookings       DemoBooking[]
  enrollments        Enrollment[]
  homeworks          Homework[]
  TeacherDocuments   TeacherDocuments?
  files              TeacherFile[]
  professionalInfo   TeacherProfessional?
  rescheduleRequests RescheduleRequest[]
  leaveRequests      LeaveRequest[]
  bankAccount        BankAccount?
  reviews            Review[]
  strikes            TeacherStrike[]
  certificates       Certificate[]
}

model TeacherProfessional {
  id                   String  @id @default(uuid())
  teacherId            String  @unique
  referredBy           String?
  qualifications       String?
  overallExperience    String?
  comfortableLanguage  String?
  schoolsTaught        String?
  workingInSchool      Boolean @default(false)
  schoolName           String?
  workingInAcademy     Boolean @default(false)
  academyName          String?
  studentsTaught       String?
  hoursPerDay          String?
  haveOwnNotes         String?
  canMakePresentations String?
  provideHomework      String?
  conductPTM           String?
  hasLaptop            Boolean @default(false)
  hasPenTab            Boolean @default(false)
  proficientInEnglish  Boolean @default(false)
  notWithOtherAcademy  Boolean @default(false)
  additionalInfo       String?
  facebook             String?
  linkedin             String?
  instagram            String?
  youtube              String?
  teacher              Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
}

model TeacherFile {
  id               String          @id @default(uuid())
  teacherId        String
  type             TeacherFileType
  s3Key            String
  originalFileName String
  mimeType         String
  fileSize         Int
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  teacher          Teacher         @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([teacherId])
  @@index([teacherId, type])
}

model TeacherDocuments {
  id                    String  @id
  teacherId             String  @unique
  videoIntroKey         String?
  photoKey              String?
  certificationKey      String?
  awardsKey             String?
  dobProofKey           String?
  addressProofKey       String?
  qualificationProofKey String?
  panCardNumber         String?
  Teacher               Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
}

model Course {
  id              String        @id @default(uuid())
  teacherId       String
  category        String?
  timeSlot        String?
  subject         String?
  grade           String?
  board           String?
  experience      String?
  duration        String?
  type            String?
  language        String?
  frequency       String?
  courseTitle     String?
  /// Deprecated (Sep 2026) — used to be a free-typed field on the
  /// create-course form. The rating shown to Parents is now always
  /// computed live from the teacher's Review aggregate (see
  /// getTeacherRatingSummary/getTeacherRatingsByIds in
  /// review.service.ts), never teacher-entered, and can't be edited
  /// at creation. Left in place (null going forward) rather than
  /// migrated away, same as ageGroup/rejectionReason above.
  rating          Float?
  objective       String?
  description     String?
  modules         String?
  courseTags      String?
  price           Decimal?      @db.Decimal(10, 2)
  thumbnailKey    String?
  introVideoKey   String?
  status          CourseStatus  @default(DRAFT)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  ageGroup        String?
  rejectionReason String?
  /// Certification (Sep 2026). Off by default — most courses issue
  /// no certificate. When on, `certificateSessionThreshold` is the
  /// number of *counted* sessions (see `ClassSessionStatus` /
  /// `COUNTED_SESSION_STATUSES` in sessionOutcome.ts — COMPLETED,
  /// STUDENT_NO_SHOW, CANCELLED_LATE, same rule TCC already uses) an
  /// Enrollment in this course needs before a certificate becomes
  /// available for the Teacher to allot. Set once at course
  /// creation — there's no course-edit screen yet to revise it.
  certificateEnabled           Boolean       @default(false)
  certificateSessionThreshold  Int?
  /// Standard pricing (Sep 2026). `standardPrice` is the platform's
  /// per-session rate snapshot computed at creation from `grade` /
  /// `isIITian` (see coursePricing.ts) — null if neither was set,
  /// which forces a manual price. `isPriceCustomized` is true when
  /// the teacher's own `price` differs from that standard rate, and
  /// is what the Admin course-review screen flags. Both are set once
  /// at creation; there's no course-edit screen yet to revise them.
  isIITian          Boolean       @default(false)
  standardPrice     Decimal?      @db.Decimal(10, 2)
  isPriceCustomized Boolean       @default(false)
  chatRooms       ChatRoom[]
  teacher         Teacher       @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  demoBookings    DemoBooking[]
  enrollments     Enrollment[]
  reviews         Review[]
  certificates    Certificate[]

  @@index([teacherId])
  @@index([status])
  @@index([teacherId, status])
}

/// Every ParentProfile gets exactly one DemoCoupon row, lazily
/// created the first time their balance is checked (see
/// getOrCreateDemoCoupon() in demoCoupon.service.ts). This is
/// account-level, not per-child: 06-OPEN-DECISIONS.md #26 — 2 free
/// demos total, shared across every Student under one parent, then
/// a flat ₹100 each after that.
model DemoCoupon {
  id          String        @id @default(uuid())
  parentId    String        @unique
  totalIssued Int           @default(2)
  usedCount   Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  bookings    DemoBooking[]
  parent      ParentProfile @relation(fields: [parentId], references: [id], onDelete: Cascade)
}

/// One row per completed "buy extra demo coupons ahead of time"
/// payment (added Sep 11, 2026) — distinct from DemoBooking's own
/// pay-per-demo Razorpay flow (createDemoBookingOrder in
/// demoCoupon.service.ts), which only ever charges the flat ₹100
/// fee for one demo at the moment it's booked. This is the
/// previously-placeholder "Buy more coupons" flow
/// (06-OPEN-DECISIONS.md #26's paid path, extended) — a parent can
/// top up their DemoCoupon.totalIssued balance in bulk before they
/// actually book anything. Exists purely as an idempotent payment
/// record (`razorpayOrderId` unique, same pattern as
/// WalletTransaction/Invoice) plus an audit trail of how many
/// coupons were bought and when — DemoCoupon.totalIssued is the
/// actual balance these purchases increment.
model DemoCouponPurchase {
  id                String        @id @default(uuid())
  parentId          String
  quantity          Int
  amount            Decimal       @db.Decimal(10, 2)
  razorpayOrderId   String        @unique
  razorpayPaymentId String?       @unique
  paidAt            DateTime      @default(now())
  createdAt         DateTime      @default(now())
  parent            ParentProfile @relation(fields: [parentId], references: [id], onDelete: Cascade)

  @@index([parentId])
}

/// One row per booked demo session. `subject` defaults to "" (never
/// null) specifically so the (teacherId, subject, studentId) unique
/// constraint below reliably enforces the "at most 1 demo per
/// teacher+subject+child" cap from 06-OPEN-DECISIONS.md #26 —
/// Postgres treats multiple NULLs as distinct in a unique index,
/// which would silently defeat this cap for any course with no
/// subject set.
model DemoBooking {
  id                String            @id @default(uuid())
  demoCouponId      String
  parentId          String
  studentId         String
  teacherId         String
  courseId          String
  subject           String            @default("")
  isPaid            Boolean           @default(false)
  amount            Decimal?          @db.Decimal(10, 2)
  status            DemoBookingStatus @default(CONFIRMED)
  scheduledAt       DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  paidAt            DateTime?
  razorpayOrderId   String?           @unique
  razorpayPaymentId String?           @unique
  isInternationalPayment Boolean      @default(false)
  internationalSurchargeAmount Decimal @default(0) @db.Decimal(10, 2)
  course            Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  demoCoupon        DemoCoupon        @relation(fields: [demoCouponId], references: [id], onDelete: Cascade)
  student           Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacher           Teacher           @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([teacherId, subject, studentId])
  @@index([parentId])
}

/// Cycle-based Enrollment (03-DATA-MODEL.md's "Enrollment (extended
/// with cycle/approval logic)" section). This captures ONLY what's
/// knowable/calculable at enrollment time — everything payment-side
/// (Transaction_Date, actual gateway ref, etc.) is deliberately left
/// out until Razorpay is integrated (02-ARCHITECTURE.md). Parent
/// name / child name / teacher name are NOT duplicated here — they
/// live on ParentProfile/Student/Teacher and should be joined in at
/// read time (e.g. for the future Tuition Ledger), same pattern as
/// everywhere else in this schema.
///
/// `parentId` is denormalized alongside `studentId`, same reasoning
/// as `DemoBooking.parentId` — lets Accounts-side queries filter
/// directly on parentId without an extra join through Student.
///
/// Pricing formula used by enrollment.service.ts (flagged back as an
/// assumption in 06-OPEN-DECISIONS.md — nothing in the docs actually
/// states how Course.price maps to a per-session vs. monthly rate,
/// so this is a judgment call pending sign-off, not a settled rule):
/// ratePerSession = Course.price (teacher's per-session rate)
/// monthlyRate    = ratePerSession * sessionsPerMonth
/// totalAmount    = monthlyRate * noOfMonths
/// dueDate        = cycleStartDate + 1 month
///
/// Sequential dual-approval (resolves 06-OPEN-DECISIONS.md #2, per
/// direct clarification Sep 1, 2026): Teacher reviews first, then
/// Admin has final say. Every new Enrollment starts at
/// PENDING_TEACHER_APPROVAL (payment already happened by this point).
/// See `status`'s own doc-comment below and
/// src/features/shared/server/enrollmentApproval.service.ts for the
/// full state machine.
model Enrollment {
  id                         String               @id @default(uuid())
  studentId                  String
  parentId                   String
  teacherId                  String
  courseId                   String
  subject                    String?
  sessionsPerMonth           Int
  noOfMonths                 Int                  @default(1)
  ratePerSession             Decimal              @db.Decimal(10, 2)
  monthlyRate                Decimal              @db.Decimal(10, 2)
  totalAmount                Decimal              @db.Decimal(10, 2)
  cycleStartDate             DateTime
  dueDate                    DateTime
  lastClassAt                DateTime?
  status                     EnrollmentStatus     @default(PENDING_TEACHER_APPROVAL)
  createdAt                  DateTime             @default(now())
  updatedAt                  DateTime             @updatedAt
  amountPaid                 Decimal              @db.Decimal(10, 2)
  paidAt                     DateTime             @default(now())
  razorpayOrderId            String               @unique
  razorpayPaymentId          String               @unique
  isInternationalPayment     Boolean              @default(false)
  internationalSurchargeAmount Decimal            @default(0) @db.Decimal(10, 2)
  adminApprovedAt            DateTime?
  pricingChangedAfterPayment Boolean              @default(false)
  rejectedBy                 String?
  rejectionReason            String?
  revisedByTeacher           Boolean              @default(false)
  revisionNote               String?
  teacherApprovedAt          DateTime?
  sessionsCompletedInCycle   Int                  @default(0)
  cyclesCompleted            Int                  @default(0)
  cyclePayoutStatus          CyclePayoutStatus    @default(IN_PROGRESS)
  lastSessionMarkedAt        DateTime?
  scheduleDays               Int[]                @default([])
  scheduleTime               String?
  /// Due-date payment reminder (added Sep 17, 2026) — see
  /// `dueDateReminder.service.ts`'s doc-comment. Set once the
  /// 5-day-before-`dueDate` reminder notification has fired for this
  /// row, so the daily cron never double-sends. Mirrors
  /// `ClassSession.reminderSentAt`'s pattern.
  dueDateReminderSentAt      DateTime?
  /// Cycle model (Part 1A, Sep 20, 2026). TRUE = created before the
  /// cycle model existed: the old months x sessions-per-month
  /// pricing, lazily generated ClassSessions, and editable schedule
  /// all keep working exactly as they did. FALSE (the default for
  /// every new row) = one-month cycles with a `EnrollmentCycle`
  /// record and all sessions created up front at activation. The
  /// migration flags every pre-existing row TRUE.
  isLegacy                   Boolean              @default(false)
  /// Length of every session in minutes, taken from Course.duration
  /// and locked at booking. Null on legacy rows.
  sessionLengthMinutes       Int?
  cycles                     EnrollmentCycle[]
  chatRoom                   ChatRoom?
  classSessions              ClassSession[]
  course                     Course               @relation(fields: [courseId], references: [id], onDelete: Cascade)
  parent                     ParentProfile        @relation(fields: [parentId], references: [id], onDelete: Cascade)
  student                    Student              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacher                    Teacher              @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  homeworks                  Homework[]
  ledgerEntries              TuitionLedgerEntry[]
  rescheduleRequests         RescheduleRequest[]
  review                     Review?
  certificate                Certificate?

  @@index([parentId])
  @@index([teacherId])
  @@index([courseId])
  @@index([studentId])
}

/// The Tuition Ledger, now a real persisted record instead of a
/// report computed on the fly (08-PROJECT-KNOWLEDGE-BASE.md's
/// "17-field record per enrollment/payment cycle"). One row is
/// created per Enrollment PER COMPLETED CYCLE — not one row per
/// Enrollment — by markSessionCompleted() in cycleProgress.service.ts,
/// the same moment cyclePayoutStatus flips to READY_FOR_PAYOUT. That
/// makes CCC (`sessionsCompleted` below) a real, final count for that
/// cycle instead of the placeholder 0 the old export-only view used.
///
/// This is also what makes "Monthly Payout Verification"
/// (08-PROJECT-KNOWLEDGE-BASE.md — Accounts' 1-day Approve/Reject
/// window per teacher payout) a real, stateful workflow: every row
/// starts PENDING_VERIFICATION with a 24h `verificationDeadline`.
/// Accounts (or Admin) approves or rejects it explicitly
/// (tuitionLedger.service.ts); if neither happens before the
/// deadline, the row is lazily flipped to EXPIRED the next time
/// anyone lists the ledger (there's no cron/job runner in this
/// project yet — see 07-LESSONS-LEARNED.md — so this is reconciled
/// on read, the same pattern the Razorpay webhook uses for dropped
/// clients). EXPIRED is a flag for Admin/Accounts to notice and
/// re-decide, not an auto-approval or auto-rejection — silently
/// paying or silently withholding a teacher's money on a missed
/// deadline would be the wrong default for money-adjacent logic.
///
/// Money fields are a snapshot at cycle-completion time and are never
/// recalculated after creation, even if the Course price changes
/// later — same reasoning as `Enrollment.amountPaid` being tracked
/// separately from `totalAmount`.
model TuitionLedgerEntry {
  id                   String             @id @default(uuid())
  enrollmentId         String
  cycleNumber          Int
  parentId             String
  teacherId            String
  studentId            String
  courseId             String
  transactionDate      DateTime
  noOfMonths           Int
  rate                 Decimal            @db.Decimal(10, 2)
  monthlyRate          Decimal            @db.Decimal(10, 2)
  totalAmount          Decimal            @db.Decimal(10, 2)
  sessionsCompleted    Int
  dueDate              DateTime
  teacherRate          Decimal            @db.Decimal(10, 2)
  monthlyTeacherPay    Decimal            @db.Decimal(10, 2)
  profits              Decimal            @db.Decimal(10, 2)
  payoutStatus         LedgerPayoutStatus @default(PENDING_VERIFICATION)
  verificationDeadline DateTime
  verifiedByStaffSub   String?
  verifiedAt           DateTime?
  rejectionReason      String?
  /// Set alongside `payoutStatus` moving to ON_HOLD — Accounts' own note, separate from `rejectionReason`.
  holdReason           String?
  /// Cognito `sub` of whichever Admin acted (Release/Reopen/Confirm Reject) — null while awaiting Admin.
  adminReviewedByStaffSub String?
  adminReviewedAt      DateTime?
  adminDecision        PayoutAdminDecision?
  payoutRecordId       String?
  paidAt               DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  enrollment           Enrollment         @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  payoutRecord         PayoutRecord?      @relation(fields: [payoutRecordId], references: [id])

  @@unique([enrollmentId, cycleNumber])
  @@index([parentId])
  @@index([teacherId])
  @@index([payoutStatus])
  @@index([payoutRecordId])
}

/// Teacher's payout bank details (built Sep 9, 2026, Teacher
/// Payouts) — previously listed as a Month-2, not-MVP entity
/// (03-DATA-MODEL.md). One per Teacher, self-managed via
/// `/teacher/bank-account`. Accounts/Admin never edit this directly —
/// only read it (mass-pay grouping, the payout snapshot below).
///
/// **Stores account number/IFSC as plain text.** Flagged, not
/// solved, in this patch — worth encrypting at rest (or at minimum
/// masking on every read path that isn't the payout itself) before
/// this carries real teacher bank details in production. See
/// 06-OPEN-DECISIONS.md #46.
model BankAccount {
  id                 String            @id @default(uuid())
  teacherId          String            @unique
  accountHolderName  String
  accountNumber      String
  ifscCode           String
  bankName           String?
  branchName         String?
  /// Bank Account Approval (Sep 10, 2026). Every create AND every
  /// edit resets this to PENDING — mass-pay only ever treats an
  /// APPROVED row as payable (see `listPaymentQueueGroupedByTeacher`
  /// in teacherPayout.service.ts). A Teacher editing already-approved
  /// details mid-review does not retroactively change what any past
  /// `PayoutRecord.bankAccountSnapshot` says was paid where — that
  /// snapshot is frozen at payout time regardless of this field.
  status             BankAccountStatus @default(PENDING)
  reviewedByStaffSub String?
  reviewedAt         DateTime?
  rejectionReason    String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  teacher            Teacher           @relation(fields: [teacherId], references: [id], onDelete: Cascade)
}

/// One row per "Pay selected teachers" mass-pay click (built Sep 9,
/// 2026, Teacher Payouts). Wraps one `PayoutRecord` per teacher that
/// was actually part of that click.
model PayoutBatch {
  id                  String            @id @default(uuid())
  initiatedByStaffSub String
  totalAmount         Decimal           @db.Decimal(10, 2)
  teacherCount        Int
  successCount        Int
  skippedCount        Int
  status              PayoutBatchStatus @default(COMPLETED)
  createdAt           DateTime          @default(now())
  records             PayoutRecord[]
}

/// One row per teacher per `PayoutBatch` — aggregates every
/// `TuitionLedgerEntry` that teacher had `QUEUED_FOR_PAYMENT` at the
/// time of that mass-pay click. `bankAccountSnapshot` freezes the
/// account details used for THIS payout (a Teacher editing their
/// bank details later must never retroactively change what an
/// already-paid record says was paid where — audit trail, not a live
/// join). `razorpayPayoutId` is null today — see
/// `src/lib/teacherPayoutGateway.ts`'s stub doc-comment.
model PayoutRecord {
  id                  String              @id @default(uuid())
  payoutBatchId       String
  teacherId           String
  amount              Decimal             @db.Decimal(10, 2)
  cycleCount          Int
  status              PayoutRecordStatus  @default(SUCCESS)
  bankAccountSnapshot Json?
  razorpayPayoutId    String?
  failureReason       String?
  createdAt           DateTime            @default(now())
  batch               PayoutBatch         @relation(fields: [payoutBatchId], references: [id], onDelete: Cascade)
  ledgerEntries       TuitionLedgerEntry[]

  @@index([teacherId])
  @@index([payoutBatchId])
}

/// One chat room per Enrollment — i.e. one per (parent, teacher,
/// course, child) combination. From the Teacher's side this reads as
/// "a separate chat room per child"; from the Parent's side, "a
/// separate chat room per teacher+course" — both are the same
/// underlying 1:1-with-Enrollment shape, per the request that
/// prompted this feature.
///
/// **Gating decision:** a ChatRoom is deliberately created alongside
/// *every* new Enrollment, not gated on `APPROVED`/`ACTIVE` — the
/// chat room IS the channel Teacher/Parent use to work out the
/// dual-approval flow itself (revisions, discussion), so it has to
/// exist from PENDING_TEACHER_APPROVAL onward, not after approval
/// finishes. See enrollmentApproval.service.ts for the full flow.
/// `REJECTED`/`CANCELLED` enrollments keep their room for Admin's
/// record, but Parent/Teacher sending is blocked — see
/// chat.service.ts's `SENDABLE_ENROLLMENT_STATUSES`.
model ChatRoom {
  id            String        @id @default(uuid())
  enrollmentId  String        @unique
  parentId      String
  teacherId     String
  courseId      String
  studentId     String
  lastMessageAt DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  messages      ChatMessage[]
  course        Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  enrollment    Enrollment    @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  parent        ParentProfile @relation(fields: [parentId], references: [id], onDelete: Cascade)
  student       Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacher       Teacher       @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([parentId])
  @@index([teacherId])
  @@index([courseId])
  @@index([studentId])
  @@index([lastMessageAt])
}

/// `senderId` stores the ParentProfile.id or Teacher.id of whoever
/// sent the message — not the raw Cognito `sub` — so Admin's
/// moderation view can join straight to a display name without
/// re-decoding a token. `senderRole` disambiguates which table
/// `senderId` points into (there's no single generic `User` table
/// yet — see 03-DATA-MODEL.md).
model ChatMessage {
  id         String         @id @default(uuid())
  chatRoomId String
  senderRole ChatSenderRole
  senderId   String
  body       String
  createdAt  DateTime       @default(now())
  chatRoom   ChatRoom       @relation(fields: [chatRoomId], references: [id], onDelete: Cascade)

  /// Phone-number flagging (`06` #31, Sep 22, 2026). If `body` (sent
  /// to Parent/Teacher) contained anything shaped like a phone
  /// number, it was masked out before saving and this is set true —
  /// the sender/recipient never see the number. `originalBody` keeps
  /// the unmasked text for Admin's moderation view only; null when
  /// nothing was flagged (the common case, saves the duplicate row
  /// width). See `src/features/chat/utils/phoneDetection.ts`.
  containsPhoneNumber Boolean @default(false)
  originalBody        String?

  @@index([chatRoomId, createdAt])
  @@index([chatRoomId, containsPhoneNumber])
}

/// Who can post in the Community room. Parents are deliberately not
/// here — the room is internal (Teachers + Admin + staff logins).
enum CommunitySenderRole {
  TEACHER
  ADMIN
  ACCOUNTS
  HR
  IT
}

/// Community (Sep 2026) — ONE global group chat for every approved
/// Teacher, Admin and staff login (Accounts / HR / IT). No parents.
/// There is no room table on purpose: there is exactly one room.
///
/// `senderId` is `Teacher.id`, `Admin.id` or `StaffAccount.id` (or the
/// Cognito `sub` for a staff login with no StaffAccount row) — loosely
/// typed like `ChatMessage.senderId`, disambiguated by `senderRole`.
/// `senderName` is a snapshot so listing needs no joins.
///
/// `isAnnouncement` = an Admin broadcast: highlighted in the room and
/// notifies every approved Teacher. Only Admin can set it.
///
/// Deletion is soft (Admin only): `deletedAt` is set and the body is
/// blanked on read. `updatedAt` is the polling cursor, so a deletion
/// reaches clients that already hold the message.
model CommunityMessage {
  id             String              @id @default(uuid())
  senderRole     CommunitySenderRole
  senderId       String
  senderName     String
  body           String
  isAnnouncement Boolean             @default(false)
  deletedAt      DateTime?
  deletedByName  String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @default(now()) @updatedAt

  @@index([createdAt])
  @@index([updatedAt])
}

/// Homework module (added Sep 4, 2026) — deliberately simple, a
/// Google-Classroom-style "assign once, submit once" flow scoped to
/// one Enrollment, not a general LMS. Only unlocked once the
/// Enrollment's dual-approval finishes (ACTIVE/LAPSED) — see
/// ACTIVE_ENROLLMENT_STATUSES in homework.service.ts, same reasoning
/// as cycleProgress.service.ts gating "mark session complete" on
/// ACTIVE only. teacherId/parentId/studentId are denormalized
/// alongside enrollmentId, same established pattern as
/// ChatRoom/DemoBooking elsewhere in this schema — lets each role's
/// list query filter directly without an extra join through
/// Enrollment.
model Homework {
  id            String              @id @default(uuid())
  enrollmentId  String
  teacherId     String
  parentId      String
  studentId     String
  title         String
  instructions  String?
  attachmentKey String?
  dueDate       DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  enrollment    Enrollment          @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  parent        ParentProfile       @relation(fields: [parentId], references: [id], onDelete: Cascade)
  student       Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacher       Teacher             @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  submission    HomeworkSubmission?

  @@index([enrollmentId])
  @@index([teacherId])
  @@index([parentId])
  @@index([studentId])
}

/// The Parent's (on the Student's behalf) submitted work for one
/// Homework row. `status` starts SUBMITTED and only ever moves to
/// REVIEWED (Teacher-set, alongside optional `feedback`) — there's no
/// numeric grading here by design, matching the "simpler than Google
/// Classroom" brief.
model HomeworkSubmission {
  id          String                   @id @default(uuid())
  homeworkId  String                   @unique
  fileKey     String
  note        String?
  status      HomeworkSubmissionStatus @default(SUBMITTED)
  feedback    String?
  submittedAt DateTime                 @default(now())
  reviewedAt  DateTime?
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
  homework    Homework                 @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
}

/// Admin-created internal staff accounts (HR, Accounts, IT). Cognito remains
/// the identity source (custom:role = "hr" | "accounts" | "it") — this row is
/// only a lightweight directory entry so Admin's Manage Staff Accounts
/// screen has something to list/search/delete against, following the
/// same pattern as ParentProfile/Teacher. Deliberately minimal for now —
/// no onboarding/profile fields yet, those come later per
/// 06-OPEN-DECISIONS.md #16 (Accounts role scope still unconfirmed). HR/IT
/// aren't in the original 4-role MVP model (02-ARCHITECTURE.md) at all, so
/// this is explicitly scoped as "create the identity (+ a simple dashboard),
/// nothing else." (IT added Sep 23, 2026.)
model StaffAccount {
  id          String    @id @default(uuid())
  cognitoSub  String    @unique
  role        StaffRole
  firstName   String
  lastName    String
  email       String    @unique
  phone       String
  createdById String
  createdAt   DateTime  @default(now())

  @@index([role])
}

/// A real, dated record of one class occurrence — the single
/// biggest MVP gap flagged in 07-LESSONS-LEARNED.md /
/// 03-DATA-MODEL.md ("Nothing records an actual class happening.
/// Session counts are a manual mark-complete button, not tied to
/// real dates/times. Ledger's CCC/MCC/TCC columns exist but are
/// hardcoded to 0 for this reason").
///
/// Rows are generated from an Enrollment's recurring
/// `scheduleDays`/`scheduleTime` (see
/// src/features/shared/server/classSession.service.ts) rather than
/// computed on the fly the way the calendar used to
/// (`scheduleOccurrences.service.ts`, now backed by this table
/// instead) — so a session's date/time/status is a real, persisted
/// fact. Editing an Enrollment's schedule only regenerates *future*,
/// still-SCHEDULED rows; COMPLETED/CANCELLED history is never
/// rewritten.
///
/// `teacherId`/`studentId`/`parentId` are denormalized off
/// `enrollmentId`, same established pattern as
/// `DemoBooking.parentId` / `ChatRoom.parentId` elsewhere in this
/// schema — lets each role's session queries filter directly without
/// an extra join through Enrollment.
model ClassSession {
  id                 String              @id @default(uuid())
  enrollmentId       String
  teacherId          String
  studentId          String
  parentId           String
  scheduledDate      DateTime
  scheduledTime      String?
  status             ClassSessionStatus  @default(SCHEDULED)
  completedAt        DateTime?
  completedByRole    String?
  cancelledAt        DateTime?
  cancelReason       String?
  /// Set once a "class starts soon" reminder notification has been
  /// sent for this session (see /api/cron/session-reminders) — the
  /// dedupe guard so the reminder cron never double-notifies the
  /// same session on a later run.
  reminderSentAt     DateTime?
  /// Cycle-model fields (Part 1A, Sep 20, 2026) — all null on legacy
  /// sessions. `startsAt`/`endsAt` are real UTC instants computed from
  /// the calendar date + wall-clock time in the platform timezone
  /// (`src/lib/platformConfig.ts`); `scheduledDate`/`scheduledTime`
  /// stay populated too so every existing reader keeps working.
  cycleId            String?
  sessionNumber      Int?
  startsAt           DateTime?
  endsAt             DateTime?
  lengthMinutes      Int?
  /// Session-flow events (Part 1B, Sep 20, 2026) — null on legacy
  /// sessions and on cycle sessions until the event happens. Each
  /// is written once and never overwritten: the teacher tapped
  /// Start, the parent tapped Join, the teacher tapped End.
  teacherStartedAt   DateTime?
  teacherEndedAt     DateTime?
  studentJoinedAt    DateTime?
  /// When `resolveSession()` (sessionResolve.service.ts) decided the
  /// event-based outcome. Null while unresolved. Cancel actions do
  /// not set it — they write their own status directly.
  resolvedAt         DateTime?
  /// Seconds both sides were present, measured at resolve time (null
  /// unless both joined). Kept so the 50% rule can be audited later.
  overlapSeconds     Int?
  /// Who cancelled: "PARENT" | "TEACHER" | "SYSTEM" (nobody joined).
  cancelledByRole    String?
  /// Set once the existing cycle counters / payout write have been
  /// applied for a session that resolved to COMPLETED — the guard
  /// that lets the sweep safely re-run that step if a request died
  /// between resolving and applying it.
  countersAppliedAt  DateTime?
  /// Make-ups and follow-ups (Part 1C, Sep 21, 2026). On a make-up
  /// session: the session it replaces (unique — a session gets at
  /// most one make-up, so the follow-up can never create two).
  makeupForSessionId String?             @unique
  /// Set (in the same transaction as any make-up / strike it
  /// caused) once the follow-up for this session's outcome has been
  /// applied — the claim that makes each follow-up happen exactly
  /// once, and what a cycle waits for before it can close.
  followUpAppliedAt  DateTime?
  /// After-class (Part 2A, Sep 21, 2026) — all null on legacy sessions
  /// and until the thing happens. The teacher's short class summary
  /// (added after End; Part 2C shows it on the class page).
  teacherSummary     String?
  teacherSummaryAt   DateTime?
  /// How the outcome was confirmed. Null while the parent's 48-hour
  /// window is open (or the outcome isn't final yet); the window
  /// itself is derived from `resolvedAt` / `cancelledAt`, never stored.
  /// PARENT_ACCEPTED / AUTO_ACCEPTED (48 h passed with no action) /
  /// ADMIN_DECIDED settle the session; REPORTED keeps it unsettled
  /// until Admin decides.
  confirmation       OutcomeConfirmation?
  /// The parent's "Report a problem" — when and what they wrote.
  /// Never returned to the teacher.
  reportedAt         DateTime?
  reportNote         String?
  /// THE flag Part 2B reads: non-null = settled (accepted, or decided
  /// by Admin); null = unsettled (window open, open report, needs
  /// review, or not final). Written once per settlement, and again
  /// only by an Admin override.
  settledAt          DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  makeupFor          ClassSession?       @relation("SessionMakeup", fields: [makeupForSessionId], references: [id], onDelete: SetNull)
  makeup             ClassSession?       @relation("SessionMakeup")
  strike             TeacherStrike?
  outcomeDecisions   SessionOutcomeDecision[]
  cycle              EnrollmentCycle?    @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  enrollment         Enrollment          @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  parent             ParentProfile       @relation(fields: [parentId], references: [id], onDelete: Cascade)
  student            Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacher            Teacher             @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  rescheduleRequests RescheduleRequest[]

  @@unique([enrollmentId, scheduledDate])
  @@unique([cycleId, sessionNumber])
  @@index([enrollmentId])
  @@index([teacherId])
  @@index([studentId])
  @@index([parentId])
  @@index([scheduledDate])
  @@index([enrollmentId, status])
  @@index([cycleId])
  @@index([status, endsAt])
  @@index([cycleId, settledAt])
  @@index([confirmation])
}

/// One billing cycle of a (non-legacy) Enrollment — Part 1A, Sep 20,
/// 2026. A cycle is one month: `startDate` to the same date next month
/// minus one day (5 Mar -> 4 Apr, both inclusive). Cycle 1 is created
/// together with the Enrollment when its first payment clears;
/// `sessionCount` is the number of chosen weekdays inside the window
/// and `price` is `ratePerSession x sessionCount`, locked at payment
/// (the international surcharge, if any, stays on the Enrollment).
/// Every non-legacy ClassSession belongs to exactly one cycle.
/// Legacy Enrollments have no cycle rows.
model EnrollmentCycle {
  id               String         @id @default(uuid())
  enrollmentId     String
  cycleNumber      Int
  startDate        DateTime       @db.Date
  endDate          DateTime       @db.Date
  sessionCount     Int
  ratePerSession   Decimal        @db.Decimal(10, 2)
  price            Decimal        @db.Decimal(10, 2)
  /// Razorpay payment ID that paid for this cycle.
  paymentReference String?
  status           CycleStatus    @default(OPEN)
  /// Cycle close (Part 1C, Sep 21, 2026) — all null while OPEN.
  /// `countedSessionCount` = sessions that counted (and are paid);
  /// `forfeitedSessionCount` = paid-for sessions that never counted.
  /// Part 2A reads these.
  closedAt              DateTime?
  closeReason           CycleCloseReason?
  countedSessionCount   Int?
  forfeitedSessionCount Int?
  /// Part 2B (Sep 21, 2026): when this cycle's payout (ledger row, if
  /// anything counted) was actually released — i.e. CLOSED AND every
  /// session settled (`ClassSession.settledAt` all non-null). Null
  /// while CLOSED but still waiting on an open dispute/confirmation
  /// window. Set at most once; `cycleClose.service.ts` is the only
  /// writer. Legacy cycles don't exist, so always null there.
  payoutReleasedAt DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  enrollment       Enrollment     @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  sessions         ClassSession[]

  @@unique([enrollmentId, cycleNumber])
  @@index([enrollmentId])
}

enum CycleStatus {
  OPEN
  CLOSED
}

/// Why a cycle closed (Part 1C): every session reached a final
/// outcome, or day 45 of the cycle passed with some still unfinished.
enum CycleCloseReason {
  ALL_SESSIONS_FINAL
  WINDOW_ENDED
}

/// A simple per-teacher record of a class the teacher caused to be
/// lost (Part 1C, Sep 21, 2026): a no-show or a teacher cancellation.
/// One strike per session (unique `classSessionId`), so it can never
/// be recorded twice. Visible to Admin; nothing acts on the count yet.
model TeacherStrike {
  id             String              @id @default(uuid())
  teacherId      String
  classSessionId String              @unique
  enrollmentId   String
  reason         TeacherStrikeReason
  createdAt      DateTime            @default(now())
  teacher        Teacher             @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  classSession   ClassSession        @relation(fields: [classSessionId], references: [id], onDelete: Cascade)

  @@index([teacherId, createdAt])
}

enum TeacherStrikeReason {
  TEACHER_NO_SHOW
  TEACHER_CANCELLED
}

/// How a cycle session's final outcome was confirmed (Part 2A).
/// Null on `ClassSession.confirmation` = not confirmed yet.
enum OutcomeConfirmation {
  PARENT_ACCEPTED
  AUTO_ACCEPTED
  REPORTED
  ADMIN_DECIDED
}

/// DECISION = Admin settling a reported / needs-review session;
/// OVERRIDE = Admin changing an outcome Admin (or the system) had
/// already settled.
enum OutcomeDecisionKind {
  DECISION
  OVERRIDE
}

/// One Admin decision or override on a session outcome (Part 2A,
/// Sep 21, 2026). Append-only audit trail — every row carries the
/// mandatory reason; the same event is also written to `ActivityLog`.
model SessionOutcomeDecision {
  id             String              @id @default(uuid())
  classSessionId String
  kind           OutcomeDecisionKind
  fromStatus     ClassSessionStatus
  toStatus       ClassSessionStatus
  reason         String
  /// Cognito `sub` (and best-effort display name) of the Admin.
  decidedBySub   String
  decidedByName  String?
  createdAt      DateTime            @default(now())
  classSession   ClassSession        @relation(fields: [classSessionId], references: [id], onDelete: Cascade)

  @@index([classSessionId, createdAt])
  @@index([createdAt])
}

/// Reschedule requests for one already-scheduled `ClassSession`
/// (added Sep 7, 2026) — moving a lecture to a different date/time,
/// independent of Enrollment's own payment/dual-approval workflow.
///
/// Single-step approval, per direct instruction (unlike Enrollment's
/// sequential Teacher->Admin chain — there's no Admin involvement
/// here at all): whoever did NOT propose the move has to approve it.
/// - Parent proposes  -> PENDING_TEACHER_APPROVAL (Teacher decides)
/// - Teacher proposes -> PENDING_PARENT_APPROVAL (Parent decides)
///
/// Approving updates the underlying ClassSession's `scheduledDate`/
/// `scheduledTime` directly (see rescheduleRequest.service.ts) — the
/// same session row simply moves, there's no separate "old" vs "new"
/// session. `originalScheduledDate`/`originalScheduledTime` here are
/// a display-only snapshot taken at request time, never re-read to
/// drive logic.
///
/// `enrollmentId`/`teacherId`/`parentId` are denormalized off
/// `classSessionId`, same established pattern as
/// `ClassSession.teacherId`/`parentId` elsewhere in this schema —
/// lets each role's request-inbox query filter directly without an
/// extra join through ClassSession/Enrollment.
model RescheduleRequest {
  id                    String                  @id @default(uuid())
  classSessionId        String
  enrollmentId          String
  teacherId             String
  parentId              String
  requestedBy           RescheduleRequestedBy
  originalScheduledDate DateTime
  originalScheduledTime String?
  proposedDate          DateTime
  proposedTime          String?
  reason                String?
  status                RescheduleRequestStatus
  responseNote          String?
  respondedAt           DateTime?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  classSession          ClassSession            @relation(fields: [classSessionId], references: [id], onDelete: Cascade)
  enrollment            Enrollment              @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  teacher               Teacher                 @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  parent                ParentProfile           @relation(fields: [parentId], references: [id], onDelete: Cascade)

  @@index([classSessionId])
  @@index([teacherId])
  @@index([parentId])
  @@index([status])
}

/// Teacher leave requests (added Sep 8, 2026) — single-step
/// Teacher -> Admin approval, independent of any specific
/// Enrollment/ClassSession (a leave is a date range on the
/// Teacher's own calendar, not tied to one student). Admin has the
/// only say — approve or reject, no counter-proposal/negotiation
/// step like RescheduleRequest has between Teacher and Parent.
/// The Teacher can withdraw their own request while it's still
/// PENDING, mirroring RescheduleRequest's cancel semantics.
model LeaveRequest {
  id          String             @id @default(uuid())
  teacherId   String
  startDate   DateTime
  endDate     DateTime
  reason      String
  status      LeaveRequestStatus @default(PENDING)
  adminNote   String?
  respondedAt DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  teacher     Teacher            @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([teacherId])
  @@index([status])
}

/// Parent/Teacher complaints & support (added Sep 10, 2026) — fills
/// the long-standing "Complaints: not built" gap flagged since Week
/// 6 (01-PROJECT-STATUS.md §2/§4, 04-BUILD-PLAN-TIMELINE.md).
/// Deliberately modeled after `LeaveRequest` (single-step, Admin is
/// the only responder) rather than `RescheduleRequest`'s two-party
/// back-and-forth — a complaint only ever needs Admin's attention,
/// never the other role's.
///
/// Unlike `LeaveRequest` (Teacher-only), a complaint can come from
/// either a Parent or a Teacher, so `raiserId`/`raiserRole` uses the
/// same loosely-typed pointer pattern as `Notification.recipientId`/
/// `ActivityLog.actorId` (no FK — see those models' doc-comments)
/// instead of two nullable relation columns, one per role.
/// `raiserName`/`raiserEmail` are a denormalized snapshot taken at
/// submission time, same reasoning as `ActivityLog.actorName`/
/// `actorEmail` — stays readable even if the underlying account is
/// later deleted (`/admin/users` supports hard-deleting a
/// Parent/Teacher).
model Complaint {
  id          String          @id @default(uuid())
  raiserId    String
  raiserRole  ComplainantRole
  raiserName  String?
  raiserEmail String?
  subject     String
  description String
  status      ComplaintStatus @default(OPEN)
  adminNote   String?
  resolvedAt  DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([raiserId, raiserRole])
  @@index([status])
}

/// Course/Teacher Reviews (added Sep 17, 2026) — distinct from
/// `Course.rating` (a teacher-entered number, never an aggregate of
/// parent feedback). A Parent may leave exactly one review per
/// Course (`@@unique([parentId, courseId])`), and only if they have
/// (or have had) an `ACTIVE` Enrollment in that course — enforced in
/// `review.service.ts`, not at the schema level, the same pattern
/// `processReferralRewardForNewEnrollment()` uses for its own
/// eligibility check. `enrollmentId` is kept as a real relation
/// (unlike `Referral.enrollmentId`'s denormalized string) since it
/// also doubles as which Enrollment justified the review being
/// allowed at all — cascades with the Enrollment so a review never
/// outlives the record that made it eligible.
///
/// This is Phase 2 scope per `02-ARCHITECTURE.md`'s Deliberately
/// Deferred list / `03-DATA-MODEL.md`'s "Full Phase 1 Entities
/// (Month 2, not MVP)" — built ahead of MVP by explicit request.
model Review {
  id           String        @id @default(uuid())
  parentId     String
  teacherId    String
  courseId     String
  enrollmentId String        @unique
  rating       Int
  comment      String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  parent     ParentProfile @relation(fields: [parentId], references: [id], onDelete: Cascade)
  teacher    Teacher       @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  course     Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  enrollment Enrollment    @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@unique([parentId, courseId])
  @@index([courseId])
  @@index([teacherId])
}

/// Certification (Sep 2026). One row per Enrollment, written only
/// once the Teacher makes a decision (ISSUED or DECLINED) — there is
/// no row while the decision is still pending, so "eligible but not
/// yet decided" is computed live from Course.certificateEnabled /
/// certificateSessionThreshold + a live count of the Enrollment's
/// counted ClassSessions (see certificate.service.ts), never cached
/// here. The decision is final: no reissue/reconsider flow yet.
/// `sessionsCompleted`/`sessionsRequired` are a snapshot of the count
/// at decision time, kept for the certificate/audit trail even if
/// later sessions change the live count.
model Certificate {
  id                String            @id @default(uuid())
  enrollmentId      String            @unique
  studentId         String
  teacherId         String
  parentId          String
  courseId          String
  status            CertificateStatus
  sessionsCompleted Int
  sessionsRequired  Int
  issuedAt          DateTime?
  declinedAt        DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  enrollment Enrollment    @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  student    Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacher    Teacher       @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  parent     ParentProfile @relation(fields: [parentId], references: [id], onDelete: Cascade)
  course     Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([teacherId])
  @@index([courseId])
}

/// Refer & Earn (added Sep 8, 2026) — a Parent's own shareable code
/// (`ParentProfile.referralCode`, lazily generated the first time
/// they open /parent/referral, same lazy-creation pattern as
/// DemoCoupon/Wallet) that a *new* Parent can enter during onboarding
/// (`Step1`'s "Referral code" field). One row per successful signup
/// that used a code — `@@unique` on `refereeParentId` means a given
/// Parent can only ever be "the referee" once. The reward is credited
/// to the *referrer's* Wallet only once the referee's first
/// Enrollment is actually created — which, per the payment gate in
/// `06-OPEN-DECISIONS.md` #36, only ever happens after a real
/// confirmed Razorpay payment. See
/// `processReferralRewardForNewEnrollment()` in
/// `referral.service.ts`, called from both `verifyEnrollmentPayment()`
/// and `reconcileEnrollmentFromWebhook()` in `enrollment.service.ts`.
/// Entering a code at signup alone never pays out anything by itself.
model Referral {
  id               String         @id @default(uuid())
  referrerParentId String
  refereeParentId  String         @unique
  code             String
  status           ReferralStatus @default(PENDING)
  rewardAmount     Decimal        @default(500) @db.Decimal(10, 2)
  /// Denormalized pointer to the Enrollment that triggered the
  /// reward — plain string, not a Prisma relation (kept simple; the
  /// `status` flip to REWARDED is what actually guards against a
  /// double credit, this field is for audit/support lookups only).
  enrollmentId String?
  rewardedAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  referrer ParentProfile @relation("ReferralsMade", fields: [referrerParentId], references: [id], onDelete: Cascade)
  referee  ParentProfile @relation("ReferralReceived", fields: [refereeParentId], references: [id], onDelete: Cascade)

  @@index([referrerParentId])
  @@index([code])
}

/// Wallet (added Sep 5, 2026) — closed-loop credit ledger per
/// ParentProfile, no cash-out (06-OPEN-DECISIONS.md #28: "Refunds
/// credit the Wallet, never the original payment method"). Account
/// level, one row per parent — same lazy-create-on-first-use
/// pattern as `DemoCoupon` (see `getOrCreateWallet()` in
/// `wallet.service.ts`), so no backfill migration is needed for
/// existing ParentProfile rows.
///
/// Nothing in this pass automatically credits a Wallet — there's no
/// automatic refund-on-Enrollment-rejection flow yet, and Razorpay
/// refunds still aren't wired up anywhere (see
/// `enrollment.service.ts`'s existing "contact support for a
/// refund" copy). The only way money moves into a Wallet today is
/// Accounts/Admin manually issuing a credit via
/// `/api/accounts/wallet/credit` (`WalletPanel.tsx`) — e.g. to
/// actually fulfil one of those "contact support" refund promises.
/// Whether Enrollment rejection/cancellation should auto-credit the
/// Wallet, and whether a Wallet balance can be spent toward a future
/// Enrollment/demo payment, are both still open — flagging rather
/// than deciding either silently. `debitWallet()` exists as the
/// natural counterpart to `creditWallet()` but has no caller yet.
model Wallet {
  id           String              @id @default(uuid())
  parentId     String              @unique
  balance      Decimal             @default(0) @db.Decimal(10, 2)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  parent       ParentProfile       @relation(fields: [parentId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]
}

/// One row per credit/debit. `amount` is always positive — `type`
/// carries the direction, same "never a signed magnitude" shape
/// Course/Enrollment money fields already use elsewhere in this
/// schema. `balanceAfter` is a snapshot (not strictly normalized,
/// deliberately denormalized) so a parent's statement reads
/// correctly without recomputing a running total client-side.
model WalletTransaction {
  id                String                @id @default(uuid())
  walletId          String
  type              WalletTransactionType
  amount            Decimal               @db.Decimal(10, 2)
  balanceAfter      Decimal               @db.Decimal(10, 2)
  reason            String
  referenceType     String?
  referenceId       String?
  createdByStaffSub String?
  createdAt         DateTime              @default(now())
  razorpayOrderId   String?               @unique
  razorpayPaymentId String?               @unique
  wallet            Wallet                @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@index([referenceType, referenceId])
}

